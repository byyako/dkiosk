<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The WebView is added in code so it can be replaced after a renderer crash. -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/errorScreen"
        layout="@layout/view_error"
        android:visibility="gone" />

    <!-- Messages sent over the API. At the bottom so it never covers the settings corner; a tap
         dismisses it. -->
    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="24dp"
        android:background="@drawable/message_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxWidth="640dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <View
        android:id="@+id/blackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- This is the physical top-right corner, including in RTL layouts. Touches are handled by
         the activity; accessibility click opens the same administrator access flow. -->
    <TextView
        android:id="@+id/adminCorner"
        android:layout_width="@dimen/settings_corner"
        android:layout_height="@dimen/settings_corner"
        android:layout_gravity="top|right"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/admin_access"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        tools:ignore="RtlHardcoded" />
</FrameLayout>
