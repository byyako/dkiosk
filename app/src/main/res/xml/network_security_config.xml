<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Kiosk pages are often LAN dashboards on plain http (http://192.168.x.x:8123). Domain configs
         can't express IP ranges, so cleartext is allowed app-wide. Self-signed HTTPS is handled
         separately by the WebViewClient, not by trust anchors here. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
